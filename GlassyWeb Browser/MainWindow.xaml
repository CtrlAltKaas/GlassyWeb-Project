<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlassyWeb_Browser.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GlassyWeb_Browser"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GlassyWeb Browser">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image x:Name="BackgroundImage"
               Grid.Row="0"
               Grid.RowSpan="2"
               Source="ms-appx:///Assets/StandardBackground.webp"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               ImageFailed="BackgroundImage_ImageFailed"
               ImageOpened="BackgroundImage_ImageOpened"/>
        <Grid Grid.Row="0" 
              x:Name="TitleBar"
              HorizontalAlignment="Stretch" 
              VerticalAlignment="Stretch"
              Background="Transparent">

            <StackPanel x:Name="TitleBarLogo"
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Spacing="10" 
                        Padding="10,0">
                <Image Source="ms-appx:///Assets/logo.png" 
                       Height="24" 
                       Stretch="Uniform" 
                       VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="TitleBarWindowControls"
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" 
                        Spacing="5" 
                        Padding="10,0"
                        TitleBar.IsDragRegion="False">
                <Grid Width="33" Height="33" 
                      HorizontalAlignment="Right"
                      Loaded="GlassPanel_Loaded">
                    <Canvas />
                    <Border BorderThickness="1.3" CornerRadius="17">
                        <Border.Background>
                            <SolidColorBrush Color="White" Opacity="0.07"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="White" Opacity="0.15"/>
                        </Border.BorderBrush>

                        <StackPanel VerticalAlignment="Center">
                            <Path Data="M96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320z" 
                                  Fill="White" 
                                  Width="11" 
                                  Height="11" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Width="33" Height="33" 
                      HorizontalAlignment="Right"
                      Loaded="GlassPanel_Loaded">
                    <Canvas />
                    <Border BorderThickness="1.3" CornerRadius="17">
                        <Border.Background>
                            <SolidColorBrush Color="White" Opacity="0.07"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="White" Opacity="0.15"/>
                        </Border.BorderBrush>

                        <StackPanel VerticalAlignment="Center">
                            <Path Data="M480 144C488.8 144 496 151.2 496 160L496 480C496 488.8 488.8 496 480 496L160 496C151.2 496 144 488.8 144 480L144 160C144 151.2 151.2 144 160 144L480 144zM160 96C124.7 96 96 124.7 96 160L96 480C96 515.3 124.7 544 160 544L480 544C515.3 544 544 515.3 544 480L544 160C544 124.7 515.3 96 480 96L160 96z" 
                                  Fill="White" 
                                  Width="11" 
                                  Height="11" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Width="33" Height="33" 
                      HorizontalAlignment="Right"
                      Loaded="GlassPanel_Loaded">
                    <Canvas />
                    <Border BorderThickness="1.3" CornerRadius="17">
                        <Border.Background>
                            <SolidColorBrush Color="White" Opacity="0.07"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="White" Opacity="0.15"/>
                        </Border.BorderBrush>

                        <StackPanel VerticalAlignment="Center">
                            <Path Data="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" 
                                  Fill="White" 
                                  Width="11" 
                                  Height="11" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Window>
